// hn_04_dialogue_parser.js
// 4번 모듈: 관계 역학 컨텍스트 고정 + 대화 로그/미세 신호 정밀 해부 보조

const bus = window.HydrogenNeonBus;
const { soul, config } = bus.getState();

if (!config.extraConfig.relationStage) {
  config.extraConfig.relationStage = "unselected";
}
if (!config.extraConfig.focusAxis) {
  config.extraConfig.focusAxis = "micro_signal";
}

const RELATION_STAGE_LABELS = {
  unselected: "미지정 (대화 내용 기준 자동 파악)",
  talking: "썸·초기 호감 탐색 단계",
  dating: "연애 중·온도차/갈등 국면",
  cooling: "거리두기·냉각·회피 국면",
  aftermath: "이별 후·여운/정리 국면",
  social: "친구·동료·대인관계 역학"
};

const FOCUS_AXIS_GUIDE = {
  micro_signal: "답장 간격·문장 길이·말투 변화·이모티콘/마침표 리듬 등 언어·행동 미세 신호 해부에 집중하라.",
  power_balance: "대화 주도권, 감정 투자 비율, 눈치·방어기제, 거절/실망 감수 의지 등 관계 역학 균형에 집중하라.",
  action_script: "지금 당장 취할 현실적 행동 선택지와 실제 메시지 초안, 상대 반응별 후속 대응 시나리오에 집중하라."
};

// 1·2·3번 모듈 프롬프트 뒤에 4번 관계 컨텍스트 & 대화 해부 지침 결합
bus.registerPromptHook((promptText) => {
  const stageKey = config.extraConfig.relationStage || "unselected";
  const axisKey = config.extraConfig.focusAxis || "micro_signal";

  const stageLine = stageKey !== "unselected"
    ? `\n[현재 고정된 관계 국면]: ${RELATION_STAGE_LABELS[stageKey]}`
    : "";

  const axisLine = `\n[집중 분석 축]: ${FOCUS_AXIS_GUIDE[axisKey] || FOCUS_AXIS_GUIDE.micro_signal}`;

  const dialogueGuide = `
[대화 로그·상황 입력 정밀 처리 규칙]
- 입력에 여러 줄의 대화나 상황 묘사가 섞여 있으면, '누가 어떤 타이밍에 어떤 형태로 반응했는지'를 흐름 순으로 먼저 정리한 뒤 심리 신호를 뽑아라.
- 추측과 사실의 경계를 흐리지 말고, 근거가 약한 추론에는 "단서 부족·가설 수준"임을 분명히 표시하라.
`;

  return `${promptText}${stageLine}${axisLine}\n${dialogueGuide}`;
});

function renderDialogueModuleDrawer() {
  bus.addDrawerSection("dialogue_context", "4. 관계 국면·분석 초점 고정", (container) => {
    container.innerHTML = `
      <p>매 질문마다 반복 설명하지 않아도 현재 관계 단계와 집중 분석 축을 프롬프트에 반영합니다.</p>

      <label style="display:block;margin-top:8px;">현재 관계 국면</label>
      <select id="hnRelationStageSelect" style="width:100%;margin-top:4px;">
        <option value="unselected">미지정 (대화 기준 자동 파악)</option>
        <option value="talking">썸·초기 호감 탐색 단계</option>
        <option value="dating">연애 중·온도차/갈등 국면</option>
        <option value="cooling">거리두기·냉각·회피 국면</option>
        <option value="aftermath">이별 후·여운/정리 국면</option>
        <option value="social">친구·동료·대인관계 역학</option>
      </select>

      <label style="display:block;margin-top:8px;">집중 분석 축</label>
      <select id="hnFocusAxisSelect" style="width:100%;margin-top:4px;">
        <option value="micro_signal">미세 신호·말투/템포 해부</option>
        <option value="power_balance">관계 주도권·감정 투자 균형</option>
        <option value="action_script">직접 행동·메시지·시나리오</option>
      </select>
    `;

    const stageSel = document.getElementById("hnRelationStageSelect");
    const axisSel = document.getElementById("hnFocusAxisSelect");

    stageSel.value = config.extraConfig.relationStage || "unselected";
    axisSel.value = config.extraConfig.focusAxis || "micro_signal";

    stageSel.addEventListener("change", () => {
      config.extraConfig.relationStage = stageSel.value;
      bus.saveConfig();
    });

    axisSel.addEventListener("change", () => {
      config.extraConfig.focusAxis = axisSel.value;
      bus.saveConfig();
    });
  });
}

renderDialogueModuleDrawer();
bus.appendMessage(
  "ai",
  `4번 모듈(관계 국면 고정·대화 해부·집중 분석 축) 결합 완료. (현재 Gen-${soul.generation})`,
  "4번 모듈 로드됨",
  false
);
